---
import Brand from "./Brand.astro";

interface Props {
  base: string;
}

const { base } = Astro.props;
const root = base.endsWith("/") ? base : `${base}/`;
const at = (path: string) => `${root}${path.replace(/^\//, "")}`;
---

<header class="site-header">
  <div class="nav-shell">
    <div class="nav-brand">
      <Brand href={at("/")} />
      <span><b></b> OPEN INDEX ENGINE</span>
    </div>
    <nav aria-label="Main navigation">
      <a href={at("/docs")}><b>01</b><span>Docs</span></a>
      <a href="https://search.parqdb.io/"><b>02</b><span>Live demo</span></a>
      <a href="https://github.com/parqdb-io/parqdb/tree/main/benchmarks/results"><b>03</b><span>Benchmarks</span></a>
    </nav>
    <div class="nav-actions">
      <a class="github-link" href="https://github.com/parqdb-io/parqdb" aria-label="ParqDB on GitHub">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .7a11.5 11.5 0 0 0-3.64 22.4c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.57-.29-5.27-1.28-5.27-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.16 1.18A10.9 10.9 0 0 1 12 6.1c.98 0 1.95.13 2.87.39 2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.71 5.39-5.29 5.68.42.36.79 1.06.79 2.14v3.18c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"/></svg>
        <span>★ Star</span>
      </a>
      <a class="nav-cta" href={at("/docs/getting-started")}><span>Get started</span><b aria-hidden="true">→</b></a>
    </div>
  </div>
  <div class="data-bus" aria-hidden="true">
    <span></span><span></span><span></span><span></span><span></span><span></span>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid #3d484f;
    background: rgba(9, 12, 16, 0.94);
    backdrop-filter: blur(12px);
  }

  .nav-shell {
    width: min(1260px, calc(100% - 32px));
    height: 72px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(220px, 1fr) auto minmax(220px, 1fr);
    align-items: center;
    border-inline: 1px solid #2c353b;
  }

  .nav-brand {
    align-self: stretch;
    display: flex;
    align-items: center;
    gap: 17px;
    padding: 0 18px;
    border-right: 1px solid #2c353b;
  }

  .nav-brand > span {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: #71817b;
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: 8px;
    letter-spacing: .1em;
    white-space: nowrap;
  }

  .nav-brand > span b { width: 6px; height: 6px; background: var(--green); animation: navBlink 2.2s steps(2, end) infinite; }

  nav {
    align-self: stretch;
    display: flex;
    align-items: center;
    gap: 0;
  }

  nav a,
  .github-link {
    color: var(--text-2);
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: 11px;
    font-weight: 650;
    letter-spacing: .045em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color 160ms ease;
  }

  nav a {
    align-self: stretch;
    display: grid;
    grid-template-columns: auto auto;
    align-content: center;
    gap: 7px;
    min-width: 112px;
    padding: 0 18px;
    border-right: 1px solid #2c353b;
  }

  nav a:first-child { border-left: 1px solid #2c353b; }
  nav a b { color: #53625d; font-size: 8px; }
  nav a:hover { color: var(--ink); background: var(--cyan); }
  nav a:hover b { color: #20515d; }

  nav a:hover,
  .github-link:hover { color: var(--green); }

  .nav-actions {
    align-self: stretch;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0;
  }

  .github-link {
    align-self: stretch;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0 17px;
    border-left: 1px solid #2c353b;
  }

  .github-link svg { width: 18px; height: 18px; }

  .nav-cta {
    align-self: center;
    display: inline-flex;
    align-items: center;
    gap: 22px;
    margin: 0 14px;
    color: var(--ink);
    border: 1px solid var(--ink);
    background: var(--green);
    padding: 10px 15px;
    border-radius: 1px;
    box-shadow: 3px 3px 0 var(--blue);
    text-decoration: none;
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: 11px;
    line-height: 1;
    font-weight: 760;
    letter-spacing: .04em;
    text-transform: uppercase;
    transition: transform 120ms ease, box-shadow 120ms ease;
  }

  .nav-cta b { font-size: 15px; line-height: 0; }

  .nav-cta:hover { transform: translate(-1px, -1px); box-shadow: 5px 5px 0 var(--blue); }

  .data-bus {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    display: grid;
    grid-template-columns: 17fr 8fr 31fr 5fr 24fr 15fr;
    gap: 3px;
    height: 3px;
    pointer-events: none;
  }

  .data-bus span { background: #263138; }
  .data-bus span:nth-child(2), .data-bus span:nth-child(5) { background: var(--blue); }
  .data-bus span:nth-child(4) { background: var(--green); }

  @keyframes navBlink { 0%, 68% { opacity: 1; } 69%, 100% { opacity: .25; } }

  @media (max-width: 760px) {
    .nav-shell { width: 100%; height: 62px; grid-template-columns: 1fr auto; border-inline: 0; }
    .nav-brand { gap: 10px; padding: 0 10px; border-right: 0; }
    .nav-brand > span { display: none; }
    nav { display: none; }
    .github-link span { display: none; }
    .github-link { align-self: stretch; padding: 0 13px; }
    .nav-cta { gap: 10px; margin: 0 9px 0 0; padding: 9px 11px; }
  }
</style>
