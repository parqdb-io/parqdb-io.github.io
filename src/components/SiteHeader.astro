---
import Brand from "./Brand.astro";

interface Props {
  base: string;
}

const { base } = Astro.props;
const root = base.endsWith("/") ? base : `${base}/`;
const at = (path: string) => `${root}${path.replace(/^\//, "")}`;
---

<header class="site-header">
  <div class="nav-shell">
    <div class="nav-brand">
      <Brand href={at("/")} variant="dark" />
    </div>
    <nav aria-label="Main navigation">
      <a href={at("/docs")}>Docs</a>
      <a href="https://search.parqdb.io/">Live demo</a>
      <a href="https://github.com/parqdb-io/parqdb/tree/main/benchmarks/results">Benchmarks</a>
    </nav>
    <div class="nav-actions">
      <a class="github-link" href="https://github.com/parqdb-io/parqdb" aria-label="ParqDB on GitHub">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .7a11.5 11.5 0 0 0-3.64 22.4c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.57-.29-5.27-1.28-5.27-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.16 1.18A10.9 10.9 0 0 1 12 6.1c.98 0 1.95.13 2.87.39 2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.71 5.39-5.29 5.68.42.36.79 1.06.79 2.14v3.18c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"/></svg>
        <span>Star on GitHub</span><b aria-hidden="true">↗</b>
      </a>
    </div>
  </div>
  <div class="data-bus" aria-hidden="true">
    <span></span><span></span><span></span><span></span><span></span><span></span>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid transparent;
    background: linear-gradient(90deg, rgba(36, 145, 255, .08), transparent 36%), #0a1220;
  }

  .nav-shell {
    width: min(1280px, calc(100% - 48px));
    height: 72px;
    margin: 0 auto;
    display: flex;
    align-items: center;
  }

  .nav-brand {
    align-self: stretch;
    display: flex;
    align-items: center;
    margin-right: auto;
    padding: 0;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  nav a,
  .github-link {
    color: #c9d1de;
    font-family: "JetBrains Mono", monospace;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0;
    text-decoration: none;
    transition: color 160ms ease;
  }

  nav a {
    padding: 8px 0;
  }

  nav a:hover { color: var(--accent); background: transparent; }

  .github-link:hover { color: var(--accent); }

  .nav-actions {
    display: flex;
    align-items: center;
    margin-left: 28px;
  }

  .github-link {
    align-self: center;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 10px 15px;
    border: 1px solid #536176;
    border-radius: 3px;
    color: #eef3fa;
    background: #121d2f;
  }

  .github-link svg { width: 18px; height: 18px; }
  .github-link b { font-size: 13px; line-height: 1; }
  .github-link:hover { color: #fff; border-color: #2491ff; background: #17263d; }

  .data-bus { display: none; }

  @media (max-width: 760px) {
    .nav-shell { width: calc(100% - 28px); height: 64px; }
    .nav-brand { padding: 0; }
    nav { display: none; }
    .nav-actions { margin-left: 16px; }
    .github-link { margin: 0; padding: 9px 11px; font-size: 10px; }
    .github-link svg { width: 16px; height: 16px; }
  }
</style>
