---
import logo from "../assets/logo.svg";
import logoDark from "../assets/logo-dark.svg";

interface Props {
  href?: string;
  variant?: "light" | "dark";
}

const { href = "/", variant = "light" } = Astro.props;
const source = variant === "dark" ? logoDark : logo;
---

<a class="brand" href={href} aria-label="ParqDB home">
  <img src={source.src} width="150" height="56" alt="ParqDB" />
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    width: 132px;
    height: 44px;
  }

  img {
    display: block;
    width: 132px;
    height: auto;
  }
</style>
