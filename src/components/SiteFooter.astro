---
import Brand from "./Brand.astro";

interface Props { base: string }
const { base } = Astro.props;
const root = base.endsWith("/") ? base : `${base}/`;
const at = (path: string) => `${root}${path.replace(/^\//, "")}`;
---

<footer>
  <div class="footer-grid">
    <div class="footer-brand">
      <Brand href={at("/")} />
      <p>Open vector search built on Parquet and Arrow.</p>
    </div>
    <div>
      <h2>Product</h2>
      <a href={at("/docs/getting-started")}>Get started</a>
      <a href="https://search.parqdb.io/">Browser demo</a>
      <a href="https://pypi.org/project/parqdb/">PyPI</a>
    </div>
    <div>
      <h2>Developers</h2>
      <a href={at("/docs")}>Documentation</a>
      <a href="https://github.com/parqdb-io/parqdb/tree/main/spec">Specification</a>
      <a href="https://github.com/parqdb-io/parqdb/tree/main/benchmarks/results">Benchmarks</a>
    </div>
    <div>
      <h2>Project</h2>
      <a href="https://github.com/parqdb-io/parqdb">GitHub</a>
      <a href="https://github.com/parqdb-io/parqdb/blob/main/CONTRIBUTING.md">Contributing</a>
      <a href="https://github.com/parqdb-io/parqdb/blob/main/LICENSE">License</a>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© {new Date().getFullYear()} ParqDB contributors</span>
    <span>MIT and Apache-2.0</span>
  </div>
</footer>

<style>
  footer {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
    padding: 72px 0 28px;
    border-top: 1px solid var(--line);
  }
  .footer-grid { display: grid; grid-template-columns: 2fr repeat(3, 1fr); gap: 48px; }
  .footer-brand p { max-width: 280px; margin: 12px 0 0; color: var(--text-3); font-size: 14px; }
  h2 { margin: 8px 0 16px; color: var(--white); font-size: 12px; text-transform: uppercase; letter-spacing: .12em; }
  footer a { display: block; width: fit-content; margin: 11px 0; color: var(--text-3); font-size: 14px; text-decoration: none; }
  footer a:hover { color: var(--white); }
  .footer-bottom { display: flex; justify-content: space-between; margin-top: 64px; padding-top: 22px; border-top: 1px solid var(--line); color: var(--text-3); font-size: 12px; }
  @media (max-width: 760px) {
    footer { width: calc(100% - 28px); }
    .footer-grid { grid-template-columns: 1fr 1fr; gap: 36px 24px; }
    .footer-brand { grid-column: 1 / -1; }
    .footer-bottom { align-items: flex-start; flex-direction: column; gap: 8px; }
  }
</style>
