---
import Brand from "../components/Brand.astro";
import "../styles/fonts.css";

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#071321" />
    <meta name="description" content="A visual direction experiment for ParqDB." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>ParqDB — Parquet Blocks</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="topbar">
      <div class="topbar-inner">
        <Brand variant="dark" />
        <nav aria-label="Primary navigation">
          <a href="/docs">Docs</a><a href="https://search.parqdb.io/">Live demo</a><a href="https://github.com/parqdb-io/parqdb/tree/main/benchmarks/results">Benchmarks</a>
        </nav>
        <a class="github" href="https://github.com/parqdb-io/parqdb">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .7a11.5 11.5 0 0 0-3.64 22.4c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.57-.29-5.27-1.28-5.27-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.16 1.18A10.9 10.9 0 0 1 12 6.1c.98 0 1.95.13 2.87.39 2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.71 5.39-5.29 5.68.42.36.79 1.06.79 2.14v3.18c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z" /></svg>
          <span>Star on GitHub</span><b aria-hidden="true">↗</b>
        </a>
      </div>
    </header>

    <main id="main">
      <section class="hero">
        <div class="hero-shell">
          <article class="hero-copy">
            <div class="eyebrow"><span class="tetromino piece-t" aria-hidden="true"><i></i><i></i><i></i><i></i></span>Open vector search infrastructure</div>
            <h1>Billion-scale<br />vector search,<br /><em>built on Parquet.</em></h1>
            <p>One open index for embedded apps, query servers, and the browser. Search data larger than memory without moving it into another proprietary system.</p>
            <div class="actions">
              <a class="primary-action" href="/docs/getting-started"><span>Get started</span><b aria-hidden="true">→</b></a>
              <a class="text-action" href="https://github.com/parqdb-io/parqdb">View source <span aria-hidden="true">↗</span></a>
            </div>
            <div class="install"><span>$</span><code>pip install parqdb</code><b>PYTHON · ARROW</b></div>
          </article>

          <aside class="index-art" data-active="embedded" aria-label="Three Parquet files in object storage queried by embedded, server, and browser runtimes">
            <header class="art-head">
              <div><span>ONE IMMUTABLE INDEX</span><strong>OBJECT STORAGE</strong></div>
              <span class="live"><i></i> OPEN</span>
            </header>
            <div class="runtime-row" role="tablist" aria-label="Query runtime">
              <button class="active" type="button" role="tab" aria-selected="true" data-runtime="embedded"><span>01</span><strong>Embedded</strong></button>
              <button type="button" role="tab" aria-selected="false" data-runtime="server"><span>02</span><strong>Server</strong></button>
              <button type="button" role="tab" aria-selected="false" data-runtime="browser"><span>03</span><strong>Browser</strong></button>
            </div>
            <div class="ascii-stage">
              <pre class="storage-scene" aria-label="Object storage containing three Parquet files whose selected pages light up">╔═ OBJECT STORAGE ═══════════╗
║                            ║░
║ centroids.parquet  <span class="byte-row" data-byte-row><i>░</i><i>░</i><i>░</i><i>░</i><i>░</i><i>░</i><i>░</i><i>░</i></span> ║░
║ postings-0042      <span class="byte-row" data-byte-row><i>░</i><i>░</i><i>░</i><i>░</i><i>░</i><i>░</i><i>░</i><i>░</i></span> ║░
║ source.parquet     <span class="byte-row" data-byte-row><i>░</i><i>░</i><i>░</i><i>░</i><i>░</i><i>░</i><i>░</i><i>░</i></span> ║░
║                            ║░
╚════════════════════════════╝░
 <span class="ascii-shadow">░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░</span></pre>
              <div class="drop-channel" aria-hidden="true">
                <span class="range-caption">HTTP RANGE · SELECTED PAGES</span>
                <span class="falling-piece shape-t"><i></i><i></i><i></i><i></i></span>
                <span class="drop-guide">│<br />│<br />▼</span>
                <span class="cache-line"></span>
              </div>
              <div class="runtime-scenes">
                <pre class="runtime-scene scene-embedded" aria-label="Selected pages falling into ParqDB embedded with its cache">╔═ APP PROCESS ══════╗
║                    ║░
║  PARQDB  │  CACHE  ║░
║                    ║░
╚════════════════════╝░
 <span>░░░░░░░░░░░░░░░░░░░░░░</span></pre>
                <pre class="runtime-scene scene-server" aria-label="Selected pages falling into a ParqDB query server">╔═ PARQDB SERVER ════╗
║                    ║░
║  ENGINE  │  CACHE  ║░
║                    ║░
╚════════════════════╝░
 <span>░░░░░░░░░░░░░░░░░░░░░░</span></pre>
                <pre class="runtime-scene scene-browser" aria-label="Selected pages falling into ParqDB WebAssembly in a browser tab">╔═ BROWSER TAB ══════╗
║                    ║░
║ PARQDB WASM│ CACHE ║░
║                    ║░
╚════════════════════╝░
 <span>░░░░░░░░░░░░░░░░░░░░░░</span></pre>
              </div>
            </div>
            <footer class="art-foot"><span>OBJECT STORAGE</span><b>RANGE → ROTATE → LOCK</b><span>CLIENT CACHE</span></footer>
          </aside>
        </div>

        <div class="proof-line" aria-label="SIFT1B benchmark results">
          <div class="metric metric-dataset"><span>DATASET</span><strong>SIFT1B</strong></div><div class="metric metric-index"><span>INDEX</span><strong>IVF–LVQ8</strong></div><div class="metric metric-latency"><span>LATENCY</span><strong>63.05 ms</strong></div><div class="metric metric-recall"><span>RECALL@10</span><strong>90.3%</strong></div><div class="metric metric-limit"><span>QUERY LIMIT</span><strong>2 cores · 4 GB</strong></div><a class="metric metric-results" href="https://github.com/parqdb-io/parqdb/tree/main/benchmarks/results/linux-x86_64-2026-08-17"><span>RAW RESULTS</span><strong>Inspect ↗</strong></a>
        </div>
      </section>

      <section class="thesis">
        <header class="thesis-copy">
          <span class="section-label"><span class="tetromino piece-l" aria-hidden="true"><i></i><i></i><i></i><i></i></span>WHY PARQDB / 03</span><h2>The index is data.<br />The engine stays open.</h2><p>ParqDB keeps vector search inside the data ecosystem you already use. Inspect it, publish it, cache it, and query it where the work happens.</p>
        </header>
        <div class="sequence">
          <article class="feature-l"><span class="sequence-index">01</span><div class="sequence-visual files-visual tetromino piece-l" aria-hidden="true"><i></i><i></i><i></i><i></i></div><div><h3>Everything is Parquet.</h3><p>Source tables and vector indexes stay in a standard, inspectable columnar format.</p></div></article>
          <article class="feature-s"><span class="sequence-index">02</span><div class="sequence-visual prune-visual tetromino piece-s" aria-hidden="true"><i></i><i></i><i></i><i></i></div><div><h3>Read only what survives.</h3><p>Route, prune, and fetch selected pages instead of loading the entire index.</p></div></article>
          <article class="feature-t"><span class="sequence-index">03</span><div class="sequence-visual runtime-visual tetromino piece-t" aria-hidden="true"><i>PY</i><i>API</i><i>WASM</i><i>↯</i></div><div><h3>Query where the work happens.</h3><p>The same immutable index serves embedded, client-server, and browser workloads.</p></div></article>
        </div>
      </section>
    </main>
    <footer class="site-footer"><span class="footer-stack" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span><Brand variant="dark" /><span>Visual direction experiment · /vision</span><a href="https://github.com/parqdb-io/parqdb">GitHub ↗</a></footer>

    <script>
      const art = document.querySelector<HTMLElement>(".index-art");
      const runtimes = [...document.querySelectorAll<HTMLButtonElement>("[data-runtime]")];
      runtimes.forEach((button) => button.addEventListener("click", () => {
        runtimes.forEach((item) => { const active = item === button; item.classList.toggle("active", active); item.setAttribute("aria-selected", String(active)); });
        art?.setAttribute("data-active", button.dataset.runtime ?? "embedded");
        art?.classList.remove("route-pulse"); if (art) void art.offsetWidth; art?.classList.add("route-pulse");
      }));

      const sourceRows = [...document.querySelectorAll<HTMLElement>("[data-byte-row]")];
      const fallingPiece = document.querySelector<HTMLElement>(".falling-piece");
      const cacheLine = document.querySelector<HTMLElement>(".cache-line");
      const shapes = ["i", "o", "t", "l", "j", "s", "z"];
      const wait = (milliseconds: number) => new Promise((resolve) => window.setTimeout(resolve, milliseconds));
      const clearSource = () => sourceRows.forEach((row) => row.querySelectorAll("i").forEach((cell) => cell.classList.remove("hot")));

      const runTransfers = async () => {
        if (!fallingPiece || !cacheLine || sourceRows.length === 0) return;
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          sourceRows[1]?.querySelectorAll("i").forEach((cell, index) => cell.classList.toggle("hot", index >= 2 && index < 6));
          fallingPiece.className = "falling-piece shape-t parked";
          return;
        }
        while (document.body.contains(fallingPiece)) {
          clearSource();
          const source = sourceRows[Math.floor(Math.random() * sourceRows.length)];
          const offset = Math.floor(Math.random() * 5);
          source?.querySelectorAll("i").forEach((cell, index) => cell.classList.toggle("hot", index >= offset && index < offset + 4));
          await wait(320);

          const shape = shapes[Math.floor(Math.random() * shapes.length)];
          const startRotation = Math.floor(Math.random() * 4) * 90;
          const turns = 1 + Math.floor(Math.random() * 3);
          fallingPiece.className = `falling-piece shape-${shape}`;
          const fall = fallingPiece.animate([
            { opacity: 0, transform: `translate(-50%, -26px) rotate(${startRotation}deg)` },
            { opacity: 1, transform: `translate(-50%, -8px) rotate(${startRotation}deg)`, offset: .16 },
            { opacity: 1, transform: `translate(-50%, 58px) rotate(${startRotation + turns * 72}deg)`, offset: .68 },
            { opacity: 1, transform: `translate(-50%, 92px) rotate(${startRotation + turns * 90}deg)` },
          ], { duration: 1550, easing: "cubic-bezier(.28,.72,.18,1)", fill: "forwards" });
          await fall.finished.catch(() => undefined);
          cacheLine.classList.remove("clearing"); void cacheLine.offsetWidth; cacheLine.classList.add("clearing");
          await wait(420);
          fall.cancel();
          fallingPiece.style.opacity = "0";
          clearSource();
          await wait(520);
        }
      };
      runTransfers();
    </script>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { background: #071321; scroll-behavior: smooth; }
  :global(body) { margin: 0; min-width: 320px; color: #091627; background: #f3f4f0; font-family: Inter, ui-sans-serif, system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
  :global(a) { color: inherit; text-decoration: none; }
  :global(button) { font: inherit; }
  :global(::selection) { color: #fff; background: #0066cc; }
  :global(:focus-visible) { outline: 3px solid #76beff; outline-offset: 4px; }
  .skip-link { position: fixed; top: -80px; left: 20px; z-index: 100; padding: 12px 16px; color: #fff; background: #0066cc; }.skip-link:focus { top: 12px; }

  .tetromino { --cell: 7px; --gap: 2px; display: grid; width: calc(var(--cell) * 3 + var(--gap) * 2); height: calc(var(--cell) * 3 + var(--gap) * 2); flex: 0 0 auto; grid-template: repeat(3, var(--cell)) / repeat(3, var(--cell)); gap: var(--gap); }
  .tetromino i { width: var(--cell); height: var(--cell); background: currentColor; }
  .piece-t i:nth-child(1) { grid-area: 1 / 1; }.piece-t i:nth-child(2) { grid-area: 1 / 2; }.piece-t i:nth-child(3) { grid-area: 1 / 3; }.piece-t i:nth-child(4) { grid-area: 2 / 2; }
  .piece-l i:nth-child(1) { grid-area: 1 / 1; }.piece-l i:nth-child(2) { grid-area: 2 / 1; }.piece-l i:nth-child(3) { grid-area: 3 / 1; }.piece-l i:nth-child(4) { grid-area: 3 / 2; }
  .piece-s i:nth-child(1) { grid-area: 1 / 2; }.piece-s i:nth-child(2) { grid-area: 1 / 3; }.piece-s i:nth-child(3) { grid-area: 2 / 1; }.piece-s i:nth-child(4) { grid-area: 2 / 2; }

  .topbar { position: relative; color: #edf5ff; background: #071321; }
  .topbar-inner { position: relative; display: grid; width: min(1280px, calc(100% - 48px)); height: 74px; align-items: center; margin-inline: auto; border-bottom: 1px solid #162b42; grid-template-columns: 1fr auto 1fr; }
  .topbar-inner::after { content: ""; position: absolute; right: 0; bottom: -1px; width: 84px; height: 3px; background: linear-gradient(90deg, #7259e8 0 24%, transparent 24% 27%, #249eff 27% 51%, transparent 51% 54%, #249eff 54% 78%, transparent 78% 81%, #249eff 81%); }
  .topbar :global(.brand) { justify-self: start; }
  nav { display: flex; align-items: center; gap: 34px; }
  nav a { position: relative; padding-block: 26px; color: #a9b8ca; font-family: "JetBrains Mono", monospace; font-size: 13px; font-weight: 700; }
  nav a::after { content: ""; position: absolute; bottom: 14px; left: calc(50% - 9px); width: 5px; height: 5px; background: #32a8ff; box-shadow: 6px 0 #32a8ff, 12px 0 #32a8ff, 6px 6px #32a8ff; opacity: 0; transform: translateY(-8px); transition: opacity 150ms ease, transform 180ms cubic-bezier(.2,.8,.2,1); }
  nav a:nth-child(2)::after { box-shadow: 0 6px #32a8ff, 0 12px #32a8ff, 6px 12px #32a8ff; }
  nav a:nth-child(3)::after { box-shadow: 6px 0 #32a8ff, -6px 6px #32a8ff, 0 6px #32a8ff; }
  nav a:hover { color: #fff; }nav a:hover::after { opacity: 1; transform: translateY(0); }
  .github { display: inline-flex; min-height: 42px; align-items: center; justify-self: end; gap: 9px; padding-right: 13px; border: 1px solid #3d4d62; font-family: "JetBrains Mono", monospace; font-size: 12px; font-weight: 700; box-shadow: 4px 4px 0 #142b45; transition: transform 160ms ease, box-shadow 160ms ease; }
  .github svg { width: 40px; height: 40px; padding: 10px; border-right: 1px solid #3d4d62; }.github:hover { border-color: #76beff; background: #10243b; box-shadow: 2px 2px 0 #249eff; transform: translate(2px,2px); }

  .hero { padding-top: 30px; color: #eef5fc; background: #071321; }
  .hero-shell { display: grid; width: min(1280px, calc(100% - 48px)); min-height: 690px; align-items: stretch; margin-inline: auto; grid-template-columns: .94fr 1.06fr; }
  .hero-copy { display: flex; min-width: 0; padding: 54px 64px 52px 0; flex-direction: column; }
  .eyebrow { display: flex; align-items: center; gap: 18px; color: #89a0b9; font-family: "JetBrains Mono", monospace; font-size: 10px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }.eyebrow .tetromino { color: #249eff; animation: gravity-lock 620ms cubic-bezier(.2,.8,.2,1) both; }
  h1 { margin: 52px 0 0; color: #f6f8fb; font-size: clamp(57px, 5.25vw, 79px); font-weight: 780; line-height: .91; letter-spacing: -.07em; }h1 em { color: #32a8ff; font-style: normal; }
  .hero-copy > p { max-width: 610px; margin: 30px 0 0; color: #9dafc2; font-size: 17px; line-height: 1.58; }
  .actions { display: flex; align-items: center; gap: 26px; margin-top: 34px; }
  .primary-action { display: grid; min-height: 48px; color: #fff; background: #0066cc; box-shadow: 6px 6px 0 #163e6c; grid-template-columns: 150px 48px; font-family: "JetBrains Mono", monospace; font-size: 12px; font-weight: 700; transition: transform 160ms ease, box-shadow 160ms ease; }
  .primary-action span, .primary-action b { display: flex; align-items: center; justify-content: center; border: 1px solid #57aaff; }.primary-action b { border-left: 0; font-size: 18px; }.primary-action:hover { box-shadow: 2px 2px 0 #249eff; transform: translate(4px,4px); }
  .text-action { color: #dce8f4; font-family: "JetBrains Mono", monospace; font-size: 11px; font-weight: 700; }.text-action span { display: inline-block; margin-left: 5px; transition: transform 180ms ease; }.text-action:hover span { transform: translate(3px, -3px); }
  .install { display: grid; min-height: 48px; align-items: stretch; margin-top: auto; border: 1px solid #273b52; color: #dbe8f5; grid-template-columns: 48px 1fr auto; }.install > span { display: grid; border-right: 1px solid #273b52; color: #32a8ff; place-items: center; }.install code { display: flex; align-items: center; padding-inline: 14px; font-family: "JetBrains Mono", monospace; font-size: 13px; }.install b { display: flex; align-items: center; padding-inline: 14px; border-left: 1px solid #273b52; color: #7f93aa; font-family: "JetBrains Mono", monospace; font-size: 8px; letter-spacing: .1em; }

  .index-art { --active-x: 16.667%; position: relative; display: flex; min-width: 0; overflow: hidden; padding: 30px 28px 24px; border-left: 1px solid #293d54; background: radial-gradient(circle at 70% 52%, rgba(34,112,188,.13), transparent 39%); flex-direction: column; }
  .index-art[data-active="server"] { --active-x: 50%; }.index-art[data-active="browser"] { --active-x: 83.333%; }
  .art-head { display: flex; align-items: flex-start; justify-content: space-between; }.art-head > div { display: grid; gap: 8px; }
  .art-head span, .art-head strong, .live { font-family: "JetBrains Mono", monospace; font-size: 9px; letter-spacing: .1em; }.art-head span { color: #788ca3; }.art-head strong { color: #aebed0; }
  .live { display: inline-flex; align-items: center; gap: 8px; color: #8fcaff; }.live i { width: 7px; height: 7px; background: #32a8ff; box-shadow: 0 0 0 5px rgba(50,168,255,.12); }
  .runtime-row { position: relative; display: grid; overflow: hidden; margin-top: 24px; border-top: 1px solid #31475f; border-bottom: 1px solid #31475f; grid-template-columns: repeat(3, 1fr); }
  .runtime-row::after { content: ""; position: absolute; z-index: 3; right: 0; bottom: 0; left: 0; height: 3px; background: #d9efff; opacity: 0; transform: scaleX(0); transform-origin: left; }
  .route-pulse .runtime-row::after { animation: line-clear 520ms cubic-bezier(.2,.8,.2,1) both; }
  .runtime-row button { position: relative; display: grid; padding: 12px 10px 15px; border: 0; border-right: 1px solid #31475f; color: #8195ac; background: transparent; text-align: left; cursor: pointer; }.runtime-row button:last-child { border-right: 0; }
  .runtime-row span { font-family: "JetBrains Mono", monospace; font-size: 8px; }.runtime-row strong { margin-top: 7px; font-size: 11px; }.runtime-row button:hover { color: #dcecff; background: #0e2238; }.runtime-row button.active { color: #fff; background: #0066cc; }
  .runtime-row button.active::after { content: ""; position: absolute; right: 10px; bottom: 6px; width: 4px; height: 4px; background: #d9efff; box-shadow: -5px 0 #d9efff, -10px 0 #d9efff, -5px -5px #d9efff; animation: gravity-lock 320ms cubic-bezier(.2,.8,.2,1) both; }

  .ascii-stage { display: grid; min-height: 440px; align-content: center; justify-items: center; margin-top: 10px; padding-block: 22px 12px; grid-template-rows: 142px 136px 116px; flex: 1; }
  .runtime-scenes { display: grid; min-height: 116px; place-items: center; }
  .runtime-scene, .storage-scene { overflow: visible; margin: 0; padding: 0; border: 0; color: #eaf3fb; background: transparent; font-family: "JetBrains Mono", monospace; font-size: clamp(10px, .94vw, 13px); font-variant-ligatures: none; font-weight: 400; line-height: 1.04; letter-spacing: 0; white-space: pre; }
  .runtime-scene { visibility: hidden; grid-area: 1 / 1; opacity: 0; transform: translateY(8px); transition: opacity 180ms ease, transform 180ms ease, visibility 0s linear 180ms; }
  .runtime-scene span, .ascii-shadow { position: relative; top: 3px; color: #46576b; }
  .index-art[data-active="embedded"] .scene-embedded, .index-art[data-active="server"] .scene-server, .index-art[data-active="browser"] .scene-browser { visibility: visible; opacity: 1; transform: translateY(0); transition-delay: 0s; }
  .storage-scene { justify-self: center; }
  .byte-row i { color: #53667b; font-style: normal; transition: color 120ms ease, text-shadow 120ms ease; }.byte-row i.hot { color: #55b7ff; text-shadow: 0 0 10px rgba(50,168,255,.9); animation: source-read 360ms ease both; }
  .drop-channel { position: relative; width: min(270px, 80%); height: 136px; border-inline: 1px dashed #233c56; }
  .range-caption { position: absolute; top: 56px; right: calc(50% + 42px); color: #687f97; font-family: "JetBrains Mono", monospace; font-size: 7px; letter-spacing: .08em; white-space: nowrap; transform: rotate(-90deg); }
  .drop-guide { position: absolute; top: 20px; left: calc(50% - 3px); color: #334e68; font-family: "JetBrains Mono", monospace; font-size: 8px; line-height: 2.3; text-align: center; }
  .falling-piece { position: absolute; z-index: 2; top: 0; left: 50%; width: 40px; height: 40px; opacity: 0; transform-origin: 20px 20px; }
