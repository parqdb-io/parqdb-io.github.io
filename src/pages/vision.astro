---
import Brand from "../components/Brand.astro";
import "../styles/fonts.css";

const pageRows = [
  { name: "centroids.parquet", hot: [8, 9] },
  { name: "postings-0042.parquet", hot: [5, 6, 7, 8] },
  { name: "source.parquet", hot: [9, 10] },
];

const cells = Array.from({ length: 12 });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#081321" />
    <meta name="description" content="ParqDB visual direction experiment." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>ParqDB — Parquet Blocks</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="topbar">
      <div class="topbar-inner">
        <Brand variant="dark" />
        <nav aria-label="Primary navigation">
          <a href="/docs">Docs</a>
          <a href="https://search.parqdb.io/">Live demo</a>
          <a href="https://github.com/parqdb-io/parqdb/tree/main/benchmarks/results">Benchmarks</a>
        </nav>
        <a class="github" href="https://github.com/parqdb-io/parqdb">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .7a11.5 11.5 0 0 0-3.64 22.4c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.57-.29-5.27-1.28-5.27-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.16 1.18A10.9 10.9 0 0 1 12 6.1c.98 0 1.95.13 2.87.39 2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.71 5.39-5.29 5.68.42.36.79 1.06.79 2.14v3.18c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z" /></svg>
          <span>Star on GitHub</span><b aria-hidden="true">↗</b>
        </a>
      </div>
    </header>

    <main id="main">
      <section class="hero">
        <div class="hero-board">
          <article class="copy-panel">
            <div class="kicker"><i aria-hidden="true"></i><span>Open vector search infrastructure</span></div>
            <h1>Billion-scale vector search, <em>built on Parquet.</em></h1>
            <p>One open index for embedded apps, query servers, and the browser. Search data larger than memory without moving it into another proprietary system.</p>
            <div class="actions">
              <a class="block-action block-action-primary" href="/docs/getting-started"><span>Get started</span><b aria-hidden="true">→</b></a>
              <a class="block-action block-action-quiet" href="https://github.com/parqdb-io/parqdb"><span>View source</span><b aria-hidden="true">↗</b></a>
            </div>
          </article>

          <div class="install-panel">
            <span class="panel-index">01 / INSTALL</span>
            <div class="command"><b>$</b><code>pip install parqdb</code></div>
            <span class="install-note">Python · Arrow-native · embedded</span>
          </div>

          <a class="proof-panel" href="https://github.com/parqdb-io/parqdb/tree/main/benchmarks/results/linux-x86_64-2026-08-17">
            <span class="panel-index">02 / PROVEN</span>
            <strong>1B</strong>
            <span>vectors · 63.05 ms</span>
            <b aria-hidden="true">↗</b>
          </a>

          <aside class="index-panel" aria-label="One Parquet index queried by three runtimes">
            <div class="index-head">
              <div>
                <span class="panel-index">SHARED INDEX / LIVE</span>
                <h2>Query the same bytes anywhere.</h2>
              </div>
              <span class="open-state"><i></i> OPEN</span>
            </div>

            <div class="runtime-switch" role="tablist" aria-label="Query runtime">
              <button class="runtime active" type="button" role="tab" aria-selected="true" data-runtime="embedded">
                <span>01</span><strong>Embedded</strong><small>in process</small>
              </button>
              <button class="runtime" type="button" role="tab" aria-selected="false" data-runtime="server">
                <span>02</span><strong>Server</strong><small>Arrow IPC</small>
              </button>
              <button class="runtime" type="button" role="tab" aria-selected="false" data-runtime="browser">
                <span>03</span><strong>Browser</strong><small>WASM</small>
              </button>
            </div>

            <div class="route" data-route>
              <div class="runtime-stems" aria-hidden="true"><i></i><i></i><i></i><b></b></div>
              <div class="page-flight" aria-hidden="true"><i></i><i></i><i></i></div>
              <div class="range-read"><span>HTTP RANGE</span><b>selected pages only</b></div>
            </div>

            <div class="object-store">
              <div class="store-label"><span>OBJECT STORAGE</span><b>PARQUET</b></div>
              <div class="files">
                {pageRows.map((row, rowIndex) => (
                  <div class="file-row">
                    <span class="file-name">{row.name}</span>
                    <span class="page-strip" role="img" aria-label={`${row.name}; selected pages ${row.hot.join(", ")}`}>
                      {cells.map((_, index) => (
                        <i class:list={[row.hot.includes(index) && "hot"]} style={`--cell-delay:${rowIndex * 80 + index * 22}ms`}></i>
                      ))}
                    </span>
                  </div>
                ))}
              </div>
              <div class="store-foot"><span>NO PROPRIETARY BLOB</span><span>NO DATA COPY</span></div>
            </div>
          </aside>
        </div>

        <div class="metric-strip" aria-label="SIFT1B benchmark summary">
          <div><span>DATASET</span><strong>SIFT1B</strong></div>
          <div><span>INDEX</span><strong>IVF–LVQ8</strong></div>
          <div><span>RECALL@10</span><strong>90.3%</strong></div>
          <div><span>QUERY LIMIT</span><strong>2 cores · 4 GB</strong></div>
          <a href="https://github.com/parqdb-io/parqdb/tree/main/benchmarks/results/linux-x86_64-2026-08-17"><span>RAW RESULTS</span><strong>Inspect ↗</strong></a>
        </div>
      </section>

      <section class="system">
        <div class="system-intro">
          <span class="section-number">03 / WHY PARQDB</span>
          <h2>The index is data.<br />The engine stays open.</h2>
          <p>ParqDB keeps vector search inside the data ecosystem you already use. Every part of the system remains inspectable, movable, and composable.</p>
        </div>

        <div class="system-blocks">
          <article class="system-card card-format">
            <span>OPEN FORMAT</span>
            <div class="mini-files" aria-hidden="true">
              <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
            </div>
            <h3>Everything is Parquet.</h3>
            <p>Source data and vector indexes use a standard columnar format—not private binary blobs.</p>
          </article>
          <article class="system-card card-prune">
            <span>BOUNDED I/O</span>
            <div class="prune-demo" aria-hidden="true">
              <b></b><b></b><b></b><b></b><b></b><b></b><b></b><b></b><b></b><b></b>
            </div>
            <h3>Read what survives pruning.</h3>
            <p>Route to clusters, prune files and row groups, then fetch only the selected pages.</p>
          </article>
          <article class="system-card card-runtime">
            <span>ANY RUNTIME</span>
            <div class="runtime-list" aria-hidden="true"><b>PY</b><b>API</b><b>WASM</b></div>
            <h3>Build once. Query anywhere.</h3>
            <p>The same immutable index serves embedded, client-server, and browser workloads.</p>
          </article>
        </div>
      </section>
    </main>

    <footer>
      <Brand variant="dark" />
      <span>Visual direction experiment · /vision</span>
      <a href="https://github.com/parqdb-io/parqdb">GitHub ↗</a>
    </footer>

    <script>
      const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-runtime]")];
      const panel = document.querySelector<HTMLElement>(".index-panel");
      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          buttons.forEach((item) => {
            const selected = item === button;
            item.classList.toggle("active", selected);
            item.setAttribute("aria-selected", String(selected));
          });
          panel?.setAttribute("data-active", button.dataset.runtime ?? "embedded");
          panel?.classList.remove("pulse");
          if (panel) void panel.offsetWidth;
          panel?.classList.add("pulse");
        });
      });
    </script>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { background: #081321; scroll-behavior: smooth; }
  :global(body) { margin: 0; min-width: 320px; color: #0a1728; background: #f4f5f1; font-family: Inter, ui-sans-serif, system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
  :global(a) { color: inherit; text-decoration: none; }
  :global(button) { font: inherit; }
  :global(::selection) { color: #fff; background: #0066cc; }
  :global(:focus-visible) { outline: 3px solid #69b9ff; outline-offset: 4px; }

  .skip-link { position: fixed; top: -80px; left: 20px; z-index: 100; padding: 12px 16px; color: #fff; background: #0066cc; }
  .skip-link:focus { top: 12px; }

  .topbar { position: relative; z-index: 10; color: #edf5ff; background: #081321; }
  .topbar-inner { display: grid; width: min(1280px, calc(100% - 48px)); height: 74px; align-items: center; margin-inline: auto; grid-template-columns: 1fr auto 1fr; }
  .topbar :global(.brand) { justify-self: start; }
  nav { display: flex; align-items: center; gap: 34px; }
  nav a { position: relative; padding: 26px 0 24px; color: #aab7c8; font-family: "JetBrains Mono", monospace; font-size: 13px; font-weight: 700; }
  nav a::after { content: ""; position: absolute; right: 0; bottom: 18px; left: 0; height: 2px; background: #2d8cff; transform: scaleX(0); transform-origin: left; transition: transform 180ms ease; }
  nav a:hover { color: #fff; }
  nav a:hover::after { transform: scaleX(1); }
  .github { display: inline-flex; min-height: 42px; align-items: center; justify-self: end; gap: 9px; padding: 0 13px 0 0; border: 1px solid #394a61; font-family: "JetBrains Mono", monospace; font-size: 12px; font-weight: 700; transition: border-color 160ms ease, background 160ms ease; }
  .github svg { width: 40px; height: 40px; padding: 10px; border-right: 1px solid #394a61; }
  .github:hover { border-color: #69b9ff; background: #10243b; }

  .hero { padding: 22px 0 0; color: #e9f1fb; background: #081321; }
  .hero-board { display: grid; width: min(1280px, calc(100% - 48px)); min-height: 626px; margin-inline: auto; grid-template-columns: repeat(12, minmax(0, 1fr)); grid-template-rows: repeat(8, minmax(70px, 1fr)); gap: 2px; background: #27384c; }
  .copy-panel, .install-panel, .proof-panel, .index-panel { position: relative; min-width: 0; overflow: hidden; }

  .copy-panel { display: flex; padding: 48px 52px; color: #0a1728; background: #f4f5f1; flex-direction: column; grid-column: 1 / 8; grid-row: 1 / 7; }
  .copy-panel::after { content: ""; position: absolute; right: 0; bottom: 0; width: 16px; height: 16px; background: #0066cc; box-shadow: -16px 0 #0066cc, 0 -16px #0066cc, -16px -16px #0066cc; }
  .kicker { display: flex; align-items: center; gap: 12px; color: #39617f; font-family: "JetBrains Mono", monospace; font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .kicker i { width: 10px; height: 10px; background: #0066cc; box-shadow: 10px 0 #0066cc, 20px 0 #0066cc, 10px 10px #0066cc; }
  h1 { max-width: 750px; margin: 48px 0 0; font-size: clamp(52px, 5.15vw, 78px); font-weight: 780; line-height: .93; letter-spacing: -.067em; }
  h1 em { display: block; color: #0066cc; font-style: normal; }
  .copy-panel > p { max-width: 650px; margin: 28px 0 0; color: #526275; font-size: 17px; line-height: 1.55; }
  .actions { display: flex; gap: 12px; margin-top: auto; padding-top: 28px; }
  .block-action { display: inline-grid; min-height: 48px; align-items: stretch; grid-template-columns: auto 48px; font-family: "JetBrains Mono", monospace; font-size: 12px; font-weight: 700; }
  .block-action span, .block-action b { display: flex; align-items: center; justify-content: center; border: 1px solid currentColor; }
  .block-action span { min-width: 140px; padding-inline: 20px; }
  .block-action b { border-left: 0; font-size: 18px; transition: transform 180ms cubic-bezier(.2,.8,.2,1); }
  .block-action:hover b { transform: translate(3px, -3px); }
  .block-action-primary { color: #fff; background: #0066cc; }
  .block-action-quiet { color: #0a1728; background: transparent; }

  .panel-index { color: inherit; font-family: "JetBrains Mono", monospace; font-size: 10px; font-weight: 700; letter-spacing: .11em; opacity: .66; }
  .install-panel { display: flex; padding: 22px 28px; color: #fff; background: #0066cc; flex-direction: column; grid-column: 1 / 5; grid-row: 7 / 9; }
  .install-panel .panel-index { color: #fff; opacity: 1; }
  .command { display: flex; align-items: center; gap: 12px; margin-top: auto; font-size: 18px; }
  .command b { color: #b9dcff; }
  .command code { font-family: "JetBrains Mono", monospace; font-size: 15px; }
  .install-note { margin-top: 9px; color: #fff; font-family: "JetBrains Mono", monospace; font-size: 9px; text-transform: uppercase; }

  .proof-panel { display: grid; padding: 20px 26px; color: #0a1728; background: #cce8ff; grid-template-columns: 1fr auto; grid-template-rows: auto 1fr auto; grid-column: 5 / 8; grid-row: 7 / 9; }
  .proof-panel .panel-index { grid-column: 1 / -1; }
  .proof-panel strong { align-self: end; font-size: 58px; line-height: .8; letter-spacing: -.06em; }
  .proof-panel > span:not(.panel-index) { align-self: end; margin-left: 2px; color: #47647e; font-family: "JetBrains Mono", monospace; font-size: 10px; }
  .proof-panel > b { align-self: end; font-size: 20px; transition: transform 180ms ease; }
  .proof-panel:hover > b { transform: translate(3px, -3px); }

  .index-panel { display: flex; padding: 30px 28px 24px; color: #eaf2fc; background-color: #101f32; background-image: linear-gradient(rgba(161,190,224,.06) 1px, transparent 1px), linear-gradient(90deg, rgba(161,190,224,.06) 1px, transparent 1px); background-size: 40px 40px; flex-direction: column; grid-column: 8 / 13; grid-row: 1 / 9; }
  .index-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; }
  .index-head h2 { max-width: 420px; margin: 10px 0 0; font-size: clamp(26px, 2.6vw, 38px); line-height: 1.02; letter-spacing: -.045em; }
  .open-state { display: inline-flex; align-items: center; gap: 7px; color: #8fc8ff; font-family: "JetBrains Mono", monospace; font-size: 9px; font-weight: 700; }
  .open-state i { width: 7px; height: 7px; background: #2d8cff; box-shadow: 0 0 0 4px rgba(45,140,255,.14); }

  .runtime-switch { display: grid; margin-top: 32px; border: 1px solid #425168; grid-template-columns: repeat(3, 1fr); }
  .runtime { display: grid; min-width: 0; padding: 13px 11px; border: 0; border-right: 1px solid #425168; color: #8e9cad; background: rgba(8,19,33,.7); text-align: left; cursor: pointer; transition: color 160ms ease, background 160ms ease; }
  .runtime:last-child { border-right: 0; }
  .runtime > span { color: #5c6c80; font-family: "JetBrains Mono", monospace; font-size: 8px; }
  .runtime strong { margin-top: 12px; font-size: 12px; }
  .runtime small { margin-top: 2px; font-family: "JetBrains Mono", monospace; font-size: 8px; }
  .runtime:hover { color: #e9f4ff; background: #182c46; }
  .runtime.active { color: #fff; background: #0066cc; }
  .runtime.active > span { color: #fff; }

  .route { position: relative; min-height: 184px; flex: 1 1 auto; }
  .route::after { content: ""; position: absolute; top: 43px; bottom: 30px; left: 50%; width: 1px; background: linear-gradient(#2d8cff, #526177 28%, #526177 72%, #2d8cff); }
  .runtime-stems { position: absolute; top: 0; right: 10%; left: 10%; height: 44px; }
  .runtime-stems i { position: absolute; top: 0; width: 1px; height: 28px; background: #526177; transition: background 160ms ease, box-shadow 160ms ease; }
  .runtime-stems i:nth-child(1) { left: 11%; }
  .runtime-stems i:nth-child(2) { left: 50%; }
  .runtime-stems i:nth-child(3) { right: 11%; }
  .runtime-stems b { position: absolute; top: 27px; right: 11%; left: 11%; height: 1px; background: #526177; }
  .runtime-stems b::after { content: ""; position: absolute; top: 0; left: 50%; width: 1px; height: 17px; background: #2d8cff; }
  .index-panel:not([data-active]), .index-panel[data-active="embedded"] { --stem: 11%; }
  .index-panel[data-active="server"] { --stem: 50%; }
  .index-panel[data-active="browser"] { --stem: 89%; }
  .runtime-stems::after { content: ""; position: absolute; top: 0; left: var(--stem); width: 1px; height: 28px; background: #69b9ff; box-shadow: 0 0 14px #2d8cff; transition: left 260ms cubic-bezier(.2,.8,.2,1); }
  .page-flight { position: absolute; z-index: 1; top: 58px; bottom: 46px; left: calc(50% - 16px); width: 32px; }
  .page-flight i { position: absolute; bottom: 0; width: 9px; height: 9px; background: #2d8cff; box-shadow: inset 0 -2px #9dccff, 0 0 12px rgba(45,140,255,.42); animation: page-return 3.2s cubic-bezier(.45,0,.2,1) infinite; }
  .page-flight i:nth-child(1) { left: 5px; }
  .page-flight i:nth-child(2) { left: 16px; animation-delay: 90ms; }
  .page-flight i:nth-child(3) { left: 16px; bottom: 11px; animation-delay: 180ms; }
  .range-read { position: absolute; right: 0; bottom: 5px; left: 0; display: flex; align-items: center; justify-content: space-between; color: #6f829a; font-family: "JetBrains Mono", monospace; font-size: 8px; }
  .range-read b { color: #9fb1c5; font-weight: 400; }

  .object-store { margin-top: auto; border: 1px solid #53647a; background: rgba(8,19,33,.86); box-shadow: 7px 7px 0 rgba(99,143,193,.18); }
  .store-label, .store-foot { display: flex; align-items: center; justify-content: space-between; font-family: "JetBrains Mono", monospace; }
  .store-label { min-height: 38px; padding: 0 14px; border-bottom: 1px solid #53647a; font-size: 9px; }
  .store-label b { color: #69b9ff; }
  .files { padding: 14px; }
  .file-row { display: grid; align-items: center; gap: 12px; grid-template-columns: minmax(0, 1fr) 180px; }
  .file-row + .file-row { margin-top: 10px; }
  .file-name { overflow: hidden; color: #a9b7c7; font-family: "JetBrains Mono", monospace; font-size: 9px; text-overflow: ellipsis; white-space: nowrap; }
  .page-strip { display: grid; gap: 3px; grid-template-columns: repeat(12, 1fr); }
  .page-strip i { height: 17px; background: #2c3a4d; animation: page-lock 540ms cubic-bezier(.2,.8,.2,1) var(--cell-delay) both; }
  .page-strip i.hot { background: #2d8cff; box-shadow: inset 0 -4px 0 #69b9ff; }
  .store-foot { min-height: 34px; padding: 0 14px; border-top: 1px solid #53647a; color: #6e7f94; font-size: 7px; }
  .pulse .page-strip i.hot { animation: page-pulse 620ms ease both; }

  .metric-strip { display: grid; width: min(1280px, calc(100% - 48px)); min-height: 92px; margin-inline: auto; border-inline: 1px solid #304157; color: #b5c2d1; grid-template-columns: repeat(5, 1fr); }
  .metric-strip > * { display: flex; min-width: 0; justify-content: center; padding: 20px 24px; border-right: 1px solid #304157; flex-direction: column; }
  .metric-strip > *:last-child { border-right: 0; }
  .metric-strip span { color: #8fa3ba; font-family: "JetBrains Mono", monospace; font-size: 8px; font-weight: 700; letter-spacing: .09em; }
  .metric-strip strong { margin-top: 7px; color: #eff6ff; font-size: 17px; }
  .metric-strip a { color: #9dccff; background: #10233b; }

  .system { display: grid; width: min(1280px, calc(100% - 48px)); margin: 110px auto 120px; grid-template-columns: repeat(12, minmax(0, 1fr)); }
  .system-intro { padding: 0 52px 54px 0; grid-column: 1 / 7; }
  .section-number { color: #0066cc; font-family: "JetBrains Mono", monospace; font-size: 10px; font-weight: 700; letter-spacing: .11em; }
  .system-intro h2 { margin: 26px 0 0; font-size: clamp(48px, 5vw, 72px); line-height: .94; letter-spacing: -.065em; }
  .system-intro p { max-width: 570px; margin: 28px 0 0; color: #5b6878; font-size: 17px; line-height: 1.65; }
  .system-blocks { display: grid; border-top: 1px solid #aeb8c3; border-left: 1px solid #aeb8c3; grid-template-columns: repeat(2, 1fr); grid-column: 7 / 13; }
  .system-card { min-height: 288px; padding: 28px; border-right: 1px solid #aeb8c3; border-bottom: 1px solid #aeb8c3; }
  .system-card > span { color: #647183; font-family: "JetBrains Mono", monospace; font-size: 9px; font-weight: 700; letter-spacing: .1em; }
  .system-card h3 { margin: 34px 0 0; font-size: 24px; line-height: 1.05; letter-spacing: -.035em; }
  .system-card p { margin: 13px 0 0; color: #5b6673; font-size: 14px; line-height: 1.55; }
  .card-format { grid-column: 1 / -1; min-height: 260px; }
  .mini-files { display: grid; max-width: 420px; margin-top: 34px; gap: 5px; grid-template-columns: repeat(8, 1fr); }
  .mini-files i { height: 34px; background: #dce3ea; }
  .mini-files i:nth-child(4), .mini-files i:nth-child(5) { background: #0066cc; }
  .prune-demo { display: grid; margin-top: 38px; gap: 4px; grid-template-columns: repeat(5, 1fr); }
  .prune-demo b { height: 18px; background: #dce3ea; }
  .prune-demo b:nth-child(3), .prune-demo b:nth-child(8) { background: #0066cc; }
  .runtime-list { display: flex; margin-top: 34px; gap: 5px; }
  .runtime-list b { display: flex; width: 54px; height: 40px; align-items: center; justify-content: center; color: #fff; background: #0d2035; font-family: "JetBrains Mono", monospace; font-size: 9px; }
  .runtime-list b:nth-child(3) { color: #0a1728; background: #cce8ff; }

  footer { display: grid; min-height: 110px; align-items: center; padding: 0 max(24px, calc((100vw - 1280px) / 2)); color: #8e9daf; background: #081321; grid-template-columns: 1fr auto 1fr; font-family: "JetBrains Mono", monospace; font-size: 9px; }
