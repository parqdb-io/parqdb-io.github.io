---
import SiteLayout from "../layouts/SiteLayout.astro";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const at = (path: string) => `${base}${path.replace(/^\//, "")}`;
const title = "ParqDB — Billion-scale vector search, built on Parquet";
const description =
  "ParqDB is an embedded vector database for larger-than-memory search and analytics, powered by Parquet and Arrow.";
---

<SiteLayout title={title} description={description}>
  <section class="hero">
    <div class="hero-grid shell">
      <div class="hero-copy">
        <h1>Billion-scale vector search, <span>built on Parquet.</span></h1>
        <p>
          ParqDB is an embedded vector database for larger-than-memory search
          and analytics, powered by Parquet and Arrow.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href={at("/docs/getting-started")}>Get started <span aria-hidden="true">→</span></a>
          <a class="button button-secondary" href="https://github.com/parqdb-io/parqdb">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .7a11.5 11.5 0 0 0-3.64 22.4c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.57-.29-5.27-1.28-5.27-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.16 1.18A10.9 10.9 0 0 1 12 6.1c.98 0 1.95.13 2.87.39 2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.71 5.39-5.29 5.68.42.36.79 1.06.79 2.14v3.18c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"/></svg>
            Star on GitHub <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="install-line" aria-label="Install command">
          <span class="prompt">$</span>
          <code>pip install parqdb</code>
          <button class="copy-command" data-copy="pip install parqdb" aria-label="Copy install command">
            <svg class="copy-icon" viewBox="0 0 20 20" aria-hidden="true"><rect x="6" y="6" width="10" height="10" rx="2" fill="none" stroke="currentColor"/><path d="M4 13H3a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v1" fill="none" stroke="currentColor"/></svg>
            <svg class="check-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="m3 10 4 4 10-9" fill="none" stroke="currentColor" stroke-width="2"/></svg>
          </button>
        </div>
        <div class="hero-index" aria-label="ParqDB system properties">
          <span><b>FORMAT</b> PARQUET</span>
          <span><b>ENGINE</b> ARROW</span>
          <span><b>RUNTIME</b> EMBEDDED</span>
        </div>
      </div>

      <div class="query-card" aria-label="One open Parquet index shared by embedded, client-server, and browser runtimes">
        <div class="query-card-head">
          <div><i></i><i></i><i></i></div>
          <span>ONE INDEX / THREE RUNTIMES</span>
          <span class="open"><b></b> OPEN</span>
        </div>
        <div class="architecture-message">
          <strong>ONE PARQUET INDEX.<br /><span>QUERY IT ANYWHERE.</span></strong>
        </div>
        <div class="runtime-overview" role="img" aria-label="Three query paths share one Parquet index: ParqDB embedded inside an application, a client using Arrow IPC with a ParqDB server, and ParqDB WebAssembly with a cache inside the browser using HTTP range requests">
          <div class="runtime-topologies" aria-hidden="true">
            <div class="runtime-topology embedded-topology">
              <span>EMBEDDED</span>
              <div class="runtime-boundary"><small>APP</small><b>PARQDB</b></div>
            </div>
            <div class="runtime-topology server-topology">
              <span>SERVER</span>
              <div class="server-runtime"><small>CLIENT</small><i>→</i><b>PARQDB</b></div>
            </div>
            <div class="runtime-topology browser-topology">
              <span>BROWSER</span>
              <div class="runtime-boundary"><small>TAB</small><b>WASM</b><i class="cache-lines"></i></div>
            </div>
          </div>
          <div class="runtime-drops" aria-hidden="true">
            <i></i><i></i><i></i>
          </div>
          <div class="shared-storage" aria-hidden="true">
            <span>OBJECT STORAGE</span>
            <div class="parquet-files">
              <i><b>PARQUET</b><small></small></i>
              <i><b>PARQUET</b><small></small></i>
              <i><b>PARQUET</b><small></small></i>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="benchmark-bar" aria-label="SIFT1B benchmark highlights">
    <div class="benchmark-grid shell">
      <a href="https://github.com/parqdb-io/parqdb/tree/main/benchmarks/results/linux-x86_64-2026-08-17">
        <strong>1 billion</strong><span>vectors searched</span>
      </a>
      <div><strong>63.05 ms</strong><span>median latency</span></div>
      <div><strong>90.3%</strong><span>Recall@10</span></div>
      <div><strong>2 cores · 4 GB</strong><span>query resource limit</span></div>
    </div>
    <p class="benchmark-note shell">SIFT1B · IVF-LVQ8 · nprobe 32 · exact conditions and raw results are published with the benchmark.</p>
  </section>

  <section class="principles shell">
    <div class="section-intro">
      <span class="eyebrow">Why ParqDB</span>
      <h2 class="section-heading">The index is data.<br />The engine stays open.</h2>
      <p class="section-copy">Vector search should fit into your data system—not force every workload through another proprietary service.</p>
    </div>
    <div class="principle-grid">
      <article>
        <div class="feature-index">01</div>
        <pre class="feature-ascii" aria-hidden="true">┌─ FILE ─────────┐
│ [RG] [RG] [RG] │
└────────────────┘<span>░</span>
 <span>░░░░░░░░░░░░░░░░</span></pre>
        <h3>Everything is Parquet</h3>
        <p>Source data and vector indexes use standard Parquet. Version, publish, inspect, and share them with the tools you already use.</p>
        <a href={at("/docs/concepts")}>Explore the format <span aria-hidden="true">→</span></a>
      </article>
      <article>
        <div class="feature-index">02</div>
        <pre class="feature-ascii pruning-ascii" aria-hidden="true">FILE   ░░<b>██</b>░░░
RG     ░░<b>██</b>░░░
PAGE   ░░<b>██</b>░░░</pre>
        <h3>Scale beyond memory</h3>
        <p>Explicit cluster, file, row-group, and page pruning keeps search bounded while the index grows far beyond RAM.</p>
        <a href="https://github.com/parqdb-io/parqdb/tree/main/benchmarks/results">Read the benchmarks <span aria-hidden="true">→</span></a>
      </article>
      <article>
        <div class="feature-index">03</div>
        <pre class="feature-ascii relational-ascii" aria-hidden="true">VECTOR ─┬─ FILTER
        ├─ JOIN
        └─ AGGREGATE</pre>
        <h3>Search stays relational</h3>
        <p>Compose vector search with filters, joins, and aggregations in one DataFusion plan, backed by Arrow-native execution.</p>
        <a href={at("/docs/guides/embedded")}>Build a query <span aria-hidden="true">→</span></a>
      </article>
    </div>
  </section>

  <section class="architecture">
    <div class="shell">
      <div class="architecture-head">
        <div>
          <span class="eyebrow">One index, multiple runtimes</span>
          <h2 class="section-heading">Build once. Query where the work happens.</h2>
        </div>
        <p>ParqDB separates the open index format from the runtime that executes it.</p>
      </div>
      <div class="runtime-map">
        <div class="map-node source-node">
          <span class="node-type">SOURCE</span>
          <strong>Multimodal table</strong>
          <small>vectors + payload</small>
          <b>PARQUET</b>
        </div>
        <div class="map-connector"><span></span><b>BUILD</b></div>
        <div class="map-node index-node">
          <span class="node-type">OPEN INDEX</span>
          <strong>IVF / LVQ4 / LVQ8</strong>
          <small>centroids + postings</small>
          <b>PARQUET</b>
        </div>
        <div class="map-fanout">
          <span></span><span></span><span></span>
        </div>
        <div class="runtime-nodes">
          <div><b>EMBEDDED</b><strong>DataFusion</strong><small>in-process Python</small></div>
          <div><b>BROWSER</b><strong>WASM</strong><small>HTTP Range</small></div>
          <div class="experimental"><b>SERVER</b><strong>Arrow IPC</strong><small>experimental</small></div>
        </div>
      </div>
    </div>
  </section>

  <section class="quickstart shell">
    <div class="quickstart-copy">
      <span class="eyebrow">Five-minute start</span>
      <h2 class="section-heading">From Parquet to nearest neighbors.</h2>
      <p class="section-copy">Install one Python package. Build a persistent IVF index. Keep the result inside the Arrow ecosystem.</p>
      <ul>
        <li><b>01</b><span>Register an existing Parquet table</span></li>
        <li><b>02</b><span>Build a source-keyed vector index</span></li>
        <li><b>03</b><span>Filter, rank, and collect as Arrow</span></li>
      </ul>
      <a class="button button-primary" href={at("/docs/getting-started")}>Follow the guide <span aria-hidden="true">→</span></a>
    </div>
    <div class="code-window">
      <div class="code-tabs" role="tablist" aria-label="Quickstart examples">
        <button role="tab" aria-selected="true" data-code-tab="python">Python</button>
        <button role="tab" aria-selected="false" data-code-tab="publish">Publish</button>
        <span>quickstart</span>
      </div>
      <pre data-code-panel="python"><code><span class="kw">import</span> parqdb

session = parqdb.<span class="fn">connect</span>(<span class="str">"./parqdb-data"</span>)
session.<span class="fn">register_parquet</span>(
    <span class="str">"documents"</span>,
    parqdb.datasets.<span class="fn">uri</span>(<span class="str">"documents"</span>),
)
documents = session.<span class="fn">table</span>(<span class="str">"documents"</span>)

documents.<span class="fn">create_index</span>(
    <span class="str">"documents_embedding"</span>,
    column=<span class="str">"embedding"</span>,
    key=[<span class="str">"document_id"</span>],
    config=parqdb.<span class="fn">IVF</span>(nlist=<span class="num">3</span>),
)
documents.<span class="fn">wait_for_index</span>(
    <span class="str">"documents_embedding"</span>
)

hits = session.<span class="fn">collect</span>(
    documents.<span class="fn">search</span>([<span class="num">0.2</span>, <span class="num">0.0</span>])
    .<span class="fn">where</span>(<span class="str">"status = 'published'"</span>)
    .<span class="fn">limit</span>(<span class="num">10</span>)
)</code></pre>
      <pre data-code-panel="publish" hidden><code><span class="prompt">$</span> pip install <span class="str">"parqdb[publish]"</span>

<span class="prompt">$</span> parqdb publish \
    --source documents.parquet \
    --key chunk_id \
    --vector-column embedding \
    --nlist <span class="num">4096</span> \
    --encoding lvq8 \
    --destination s3://my-bucket/wiki/v1 \
    --public-url \
      https://data.example.com/wiki/v1

<span class="comment"># manifest.json is exposed only after every
# immutable object is uploaded and verified.</span></code></pre>
    </div>
  </section>

  <section class="browser-feature shell">
    <div class="browser-panel">
      <div class="browser-copy">
        <span class="eyebrow">Static HTTP index</span>
        <h2>Object storage becomes the query endpoint.</h2>
        <p>Publish an immutable IVF-LVQ index and query only the required Parquet byte ranges in WebAssembly. No query server sits between the browser and your data.</p>
        <div class="browser-actions">
          <a class="button button-primary" href="https://search.parqdb.io/">Run the live demo <span aria-hidden="true">↗</span></a>
          <a href={at("/docs/guides/browser")}>Publication guide <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="http-trace" aria-label="Example HTTP Range trace">
        <div class="trace-header"><span>HTTP TRACE</span><span><b></b> LIVE INDEX</span></div>
        <div class="trace-row range"><b>RANGE</b><span>centroids.parquet</span><code>0–262143</code><em>206</em></div>
        <div class="trace-row hit"><b>HIT</b><span>roots.parquet</span><code>memory cache</code><em>CACHE</em></div>
        <div class="trace-row range"><b>RANGE</b><span>cid_bucket=000041</span><code>8630–144983</code><em>206</em></div>
        <div class="trace-row range"><b>RANGE</b><span>documents.parquet</span><code>17465660–17483301</code><em>206</em></div>
        <div class="trace-footer"><span>QUERY TEXT NEVER LEAVES THIS TAB</span><span>WASM / LVQ8</span></div>
      </div>
    </div>
  </section>

  <section class="final-cta shell">
    <span class="eyebrow">Start in process</span>
    <h2>Keep your vectors in an open format.</h2>
    <p>Install ParqDB and build your first index from an existing Parquet table.</p>
    <div>
      <a class="button button-primary" href={at("/docs/getting-started")}>Read the docs <span aria-hidden="true">→</span></a>
      <a class="button button-secondary" href="https://github.com/parqdb-io/parqdb">View GitHub <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <script>
    document.querySelectorAll(".copy-command").forEach((button) => {
      button.addEventListener("click", async () => {
        if (!(button instanceof HTMLElement)) return;
        await navigator.clipboard.writeText(button.dataset.copy ?? "");
        button.classList.add("copied");
        window.setTimeout(() => button.classList.remove("copied"), 1400);
      });
    });

    document.querySelectorAll("[data-code-tab]").forEach((tab) => {
      tab.addEventListener("click", () => {
        if (!(tab instanceof HTMLElement)) return;
        const selected = tab.dataset.codeTab;
        document.querySelectorAll("[data-code-tab]").forEach((item) =>
          item.setAttribute("aria-selected", String(item === tab)),
        );
        document.querySelectorAll("[data-code-panel]").forEach((panel) => {
          if (panel instanceof HTMLElement) panel.hidden = panel.dataset.codePanel !== selected;
        });
      });
    });

  </script>
</SiteLayout>

<style>
  .hero { position: relative; overflow: hidden; padding: 50px 0 68px; border-bottom: 1px solid #344158; background: #0a1220; }
  .hero::before { content: ""; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(90deg, rgba(36,145,255,.08), transparent 36%); }
  .hero::after { display: none; }
  .hero-grid { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; gap: 62px; width: min(1280px, calc(100% - 48px)); }
  h1 { max-width: 660px; margin: 0; color: #f7f9fc; font-family: "JetBrains Mono", monospace; font-size: clamp(48px, 4.5vw, 64px); font-weight: 700; line-height: .96; letter-spacing: -.055em; }
  h1 span { color: #2491ff; }
  .hero-copy > p { max-width: 620px; margin: 24px 0 0; color: #b8c2d1; font-family: "JetBrains Mono", monospace; font-size: clamp(15px, 1.35vw, 17px); line-height: 1.55; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 15px; margin-top: 28px; }
  .hero-actions svg { width: 17px; height: 17px; }
  .install-line { display: flex; width: min(100%, 390px); align-items: center; margin-top: 20px; padding: 10px 12px; border: 1px solid #43516a; border-radius: 3px; color: #eef3fa; background: #111b2e; box-shadow: 4px 4px 0 #050a12; font-size: 12px; }
  .install-line .prompt { margin-right: 10px; color: var(--accent); }
  .copy-command { width: 28px; height: 28px; margin-left: auto; padding: 5px; border: 1px solid transparent; color: var(--text-3); background: transparent; cursor: pointer; }
  .copy-command:hover { color: var(--cyan); border-color: #39434a; }
  .copy-command svg { width: 16px; height: 16px; }
  .check-icon, .copy-command.copied .copy-icon { display: none; }
  .copy-command.copied .check-icon { display: block; color: var(--accent); }
  .hero-index { display: flex; flex-wrap: wrap; gap: 8px 20px; margin-top: 19px; color: #8e9aad; font-family: "JetBrains Mono", monospace; font-size: 9px; letter-spacing: .08em; }
  .hero-index b { color: #d0d7e2; font-weight: 400; }
  .hero .button-primary { color: #fff; border-color: #2491ff; background: #147ce5; box-shadow: 4px 4px 0 #064784; }
  .hero .button-primary:hover { color: #fff; border-color: #49a4ff; background: #2491ff; box-shadow: 5px 5px 0 #064784; }
  .hero .button-secondary { color: #172033; border-color: #d9e0ea; background: #eef2f8; box-shadow: 4px 4px 0 #667287; }
  .hero .button-secondary:hover { color: #0066cc; border-color: #fff; background: #fff; box-shadow: 5px 5px 0 #667287; }
  .query-card { position: relative; min-width: 0; padding: 6px 0 0; color: #f5f5f7; }
  .query-card-head { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 12px 0; color: #8f959f; font-family: "JetBrains Mono", monospace; font-size: 9px; letter-spacing: .08em; }
  .query-card-head > div { display: flex; gap: 4px; }
  .query-card-head i { width: 7px; height: 7px; background: #727780; }
  .query-card-head i:first-child { background: #9b69ff; }
  .query-card-head i:nth-child(2) { background: #28b9ff; }
  .query-card-head .open { justify-self: end; color: #28b9ff; }
  .query-card-head .open b { display: inline-block; width: 6px; height: 6px; margin-right: 6px; background: currentColor; }
  .architecture-message { margin: 12px 0 18px; }
  .architecture-message strong { display: block; color: #f5f5f7; font-size: clamp(20px, 2vw, 27px); font-weight: 850; line-height: 1.03; letter-spacing: -.045em; }
  .architecture-message strong span { color: var(--accent); }
  .runtime-overview { min-height: 268px; padding-top: 14px; }
  .runtime-topologies { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 26px; }
  .runtime-topology { min-width: 0; }
  .runtime-topology > span { display: block; margin-bottom: 9px; color: #8492a6; font-family: "JetBrains Mono", monospace; font-size: 7px; letter-spacing: .1em; text-align: center; }
  .runtime-boundary, .server-runtime { height: 58px; color: #dce5f1; font-family: "JetBrains Mono", monospace; }
  .runtime-boundary { position: relative; display: grid; place-items: center; border: 1px solid #66758b; }
  .runtime-boundary small { position: absolute; top: 5px; left: 7px; color: #8492a6; font-size: 6px; letter-spacing: .08em; }
  .runtime-boundary b { padding: 6px 10px; border: 1px solid #8da0b8; font-size: 9px; font-weight: 600; }
  .server-runtime { display: grid; grid-template-columns: auto 1fr auto; align-items: center; }
  .server-runtime small, .server-runtime b { padding: 8px 7px; border: 1px solid #8da0b8; font-size: 7px; font-weight: 600; }
  .server-runtime i { color: #8dbfff; font-size: 13px; font-style: normal; text-align: center; }
  .cache-lines { position: absolute; right: 8px; bottom: 7px; width: 17px; height: 7px; border-block: 1px solid #28b9ff; }
  .cache-lines::after { content: ""; position: absolute; top: 2px; right: 0; left: 5px; border-top: 1px solid #28b9ff; }
  .runtime-drops { display: grid; grid-template-columns: repeat(3, 1fr); height: 47px; }
  .runtime-drops i { position: relative; justify-self: center; width: 1px; height: 36px; background: #66758b; }
  .runtime-drops i::after { content: ""; position: absolute; bottom: -1px; left: -3px; border-top: 6px solid #8dbfff; border-inline: 3px solid transparent; }
  .shared-storage { position: relative; min-height: 98px; padding: 25px 24px 18px; border: 2px solid #dce5f1; color: #f5f5f7; box-shadow: 6px 6px 0 #27354a; }
  .shared-storage > span { position: absolute; top: -8px; left: 18px; padding: 0 8px; background: #0a1220; font-family: "JetBrains Mono", monospace; font-size: 10px; letter-spacing: .06em; }
  .parquet-files { display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; }
  .parquet-files > i { position: relative; display: grid; height: 43px; place-items: center; overflow: hidden; border: 1px solid #66758b; font-style: normal; }
  .parquet-files b { position: relative; z-index: 1; font-family: "JetBrains Mono", monospace; font-size: 7px; font-weight: 500; letter-spacing: .06em; }
  .parquet-files small { position: absolute; right: 0; bottom: 0; left: 0; height: 8px; background: repeating-linear-gradient(90deg, #344158 0 8px, transparent 8px 11px); }
  .parquet-files > i:nth-child(2) small::after { content: ""; position: absolute; top: 0; left: 42%; width: 20%; height: 100%; background: #28b9ff; }
  .benchmark-bar { position: relative; padding: 31px 0 25px; border-bottom: 1px solid #d5dae2; color: #111827; background: #f7f8fa; }
  .benchmark-bar > .shell { width: min(1280px, calc(100% - 48px)); }
  .benchmark-grid { position: relative; display: grid; grid-template-columns: repeat(4, 1fr); }
  .benchmark-grid::before { content: ""; position: absolute; top: -31px; left: 0; width: 116px; height: 4px; background: linear-gradient(90deg, #9aa5b4 0 18%, transparent 18% 22%, #9aa5b4 22% 40%, transparent 40% 44%, #0ea5ee 44% 66%, transparent 66% 70%, #9aa5b4 70% 100%); }
  .benchmark-grid > * { padding: 0 28px; border-right: 1px solid #c3cad4; color: #111827; text-decoration: none; }
  .benchmark-grid > *:first-child { padding-left: 0; }
  .benchmark-grid > *:last-child { border: 0; }
  .benchmark-grid strong { display: block; color: #111827; font-family: "JetBrains Mono", monospace; font-size: 24px; font-weight: 700; letter-spacing: -.04em; }
  .benchmark-grid span { display: block; margin-top: 4px; color: #5e6878; font-family: "JetBrains Mono", monospace; font-size: 10px; letter-spacing: .04em; text-transform: uppercase; }
  .benchmark-grid a:hover strong { color: #0068d8; }
  .benchmark-note { margin-top: 22px; color: #697384; font-family: "JetBrains Mono", monospace; font-size: 9px; text-transform: uppercase; letter-spacing: .07em; }
  .principles { padding-block: 136px; color: var(--ink); background: #fff; box-shadow: 0 0 0 100vmax #fff; clip-path: inset(0 -100vmax); }
  .principles .eyebrow { color: var(--accent); }
  .principles .section-heading { color: var(--ink); }
  .principles .section-copy { color: var(--text-2); }
  .principle-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 68px; }
  .principle-grid article { position: relative; min-height: 370px; padding: 38px 30px 31px; border: 1px solid #aeb8c5; border-radius: 2px; background: #fff; transition: border-color 120ms ease, background 120ms ease; }
  .principle-grid article:hover { border-color: #738297; background: #f8fafc; }
