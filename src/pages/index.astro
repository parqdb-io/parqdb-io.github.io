---
import SiteLayout from "../layouts/SiteLayout.astro";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const at = (path: string) => `${base}${path.replace(/^\//, "")}`;
const title = "ParqDB — Billion-scale vector search, built on Parquet";
const description =
  "ParqDB is an embedded vector database for larger-than-memory search and analytics, powered by Parquet and Arrow.";
---

<SiteLayout title={title} description={description}>
  <section class="hero">
    <div class="hero-grid shell">
      <div class="hero-copy">
        <div class="release-pill">
          <span class="release-dot"></span>
          <span>Open source · Python 3.11–3.14</span>
          <a href="https://pypi.org/project/parqdb/">View on PyPI <span aria-hidden="true">↗</span></a>
        </div>
        <h1>Billion-scale vector search, <span>built on Parquet.</span></h1>
        <p>
          ParqDB is an embedded vector database for larger-than-memory search
          and analytics, powered by Parquet and Arrow.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href={at("/docs/getting-started")}>Get started <span aria-hidden="true">→</span></a>
          <a class="button button-secondary" href="https://github.com/parqdb-io/parqdb">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .7a11.5 11.5 0 0 0-3.64 22.4c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.57-.29-5.27-1.28-5.27-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.16 1.18A10.9 10.9 0 0 1 12 6.1c.98 0 1.95.13 2.87.39 2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.71 5.39-5.29 5.68.42.36.79 1.06.79 2.14v3.18c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"/></svg>
            Star on GitHub <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="install-line" aria-label="Install command">
          <span class="prompt">$</span>
          <code>pip install parqdb</code>
          <button class="copy-command" data-copy="pip install parqdb" aria-label="Copy install command">
            <svg class="copy-icon" viewBox="0 0 20 20" aria-hidden="true"><rect x="6" y="6" width="10" height="10" rx="2" fill="none" stroke="currentColor"/><path d="M4 13H3a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v1" fill="none" stroke="currentColor"/></svg>
            <svg class="check-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="m3 10 4 4 10-9" fill="none" stroke="currentColor" stroke-width="2"/></svg>
          </button>
        </div>
      </div>

      <div class="query-card" aria-label="ParqDB query execution illustration">
        <div class="query-card-head">
          <div><i></i><i></i><i></i></div>
          <span>QUERY PLAN / IVF-LVQ8</span>
          <span class="live"><b></b> READY</span>
        </div>
        <div class="plan-body">
          <div class="plan-row active">
            <span class="step">01</span>
            <span class="operator">ROUTE</span>
            <span class="detail">centroids.parquet</span>
            <span class="metric">64 probes</span>
          </div>
          <div class="plan-line"><span></span></div>
          <div class="plan-row active">
            <span class="step">02</span>
            <span class="operator">PRUNE</span>
            <span class="detail">cid_bucket + row group</span>
            <span class="metric">bounded I/O</span>
          </div>
          <div class="plan-line"><span></span></div>
          <div class="plan-row active">
            <span class="step">03</span>
            <span class="operator">RANK</span>
            <span class="detail">native LVQ8 kernel</span>
            <span class="metric">top k</span>
          </div>
          <div class="plan-line"><span></span></div>
          <div class="plan-row result">
            <span class="step">04</span>
            <span class="operator">JOIN</span>
            <span class="detail">source keys → Parquet</span>
            <span class="metric">Arrow</span>
          </div>
        </div>
        <div class="object-strip">
          <span>PARQUET</span><span>ARROW</span><span>DATAFUSION</span><span>SIMD</span>
        </div>
      </div>
    </div>
  </section>

  <section class="benchmark-bar" aria-label="SIFT1B benchmark highlights">
    <div class="benchmark-grid shell">
      <a href="https://github.com/parqdb-io/parqdb/tree/main/benchmarks/results/linux-x86_64-2026-08-17">
        <strong>1 billion</strong><span>vectors searched</span>
      </a>
      <div><strong>63.05 ms</strong><span>median latency</span></div>
      <div><strong>90.3%</strong><span>Recall@10</span></div>
      <div><strong>2 cores · 4 GB</strong><span>query resource limit</span></div>
    </div>
    <p class="benchmark-note shell">SIFT1B · IVF-LVQ8 · nprobe 32 · exact conditions and raw results are published with the benchmark.</p>
  </section>

  <section class="principles shell">
    <div class="section-intro">
      <span class="eyebrow">Why ParqDB</span>
      <h2 class="section-heading">The index is data.<br />The engine stays open.</h2>
      <p class="section-copy">Vector search should fit into your data system—not force every workload through another proprietary service.</p>
    </div>
    <div class="principle-grid">
      <article>
        <div class="feature-index">01</div>
        <div class="feature-icon layers" aria-hidden="true"><span></span><span></span><span></span></div>
        <h3>Everything is Parquet</h3>
        <p>Source data and vector indexes use standard Parquet. Version, publish, inspect, and share them with the tools you already use.</p>
        <a href={at("/docs/concepts")}>Explore the format <span aria-hidden="true">→</span></a>
      </article>
      <article>
        <div class="feature-index">02</div>
        <div class="feature-icon bounded" aria-hidden="true"><span></span><span></span></div>
        <h3>Scale beyond memory</h3>
        <p>Explicit cluster, file, row-group, and page pruning keeps search bounded while the index grows far beyond RAM.</p>
        <a href="https://github.com/parqdb-io/parqdb/tree/main/benchmarks/results">Read the benchmarks <span aria-hidden="true">→</span></a>
      </article>
      <article>
        <div class="feature-index">03</div>
        <div class="feature-icon relational" aria-hidden="true"><span></span><span></span><span></span></div>
        <h3>Search stays relational</h3>
        <p>Compose vector search with filters, joins, and aggregations in one DataFusion plan, backed by Arrow-native execution.</p>
        <a href={at("/docs/guides/embedded")}>Build a query <span aria-hidden="true">→</span></a>
      </article>
    </div>
  </section>

  <section class="architecture">
    <div class="shell">
      <div class="architecture-head">
        <div>
          <span class="eyebrow">One index, multiple runtimes</span>
          <h2 class="section-heading">Build once. Query where the work happens.</h2>
        </div>
        <p>ParqDB separates the open index format from the runtime that executes it.</p>
      </div>
      <div class="runtime-map">
        <div class="map-node source-node">
          <span class="node-type">SOURCE</span>
          <strong>Multimodal table</strong>
          <small>vectors + payload</small>
          <b>PARQUET</b>
        </div>
        <div class="map-connector"><span></span><b>BUILD</b></div>
        <div class="map-node index-node">
          <span class="node-type">OPEN INDEX</span>
          <strong>IVF / LVQ4 / LVQ8</strong>
          <small>centroids + postings</small>
          <b>PARQUET</b>
        </div>
        <div class="map-fanout">
          <span></span><span></span><span></span>
        </div>
        <div class="runtime-nodes">
          <div><b>EMBEDDED</b><strong>DataFusion</strong><small>in-process Python</small></div>
          <div><b>BROWSER</b><strong>WASM</strong><small>HTTP Range</small></div>
          <div class="experimental"><b>SERVER</b><strong>Arrow IPC</strong><small>experimental</small></div>
        </div>
      </div>
    </div>
  </section>

  <section class="quickstart shell">
    <div class="quickstart-copy">
      <span class="eyebrow">Five-minute start</span>
      <h2 class="section-heading">From Parquet to nearest neighbors.</h2>
      <p class="section-copy">Install one Python package. Build a persistent IVF index. Keep the result inside the Arrow ecosystem.</p>
      <ul>
        <li><b>01</b><span>Register an existing Parquet table</span></li>
        <li><b>02</b><span>Build a source-keyed vector index</span></li>
        <li><b>03</b><span>Filter, rank, and collect as Arrow</span></li>
      </ul>
      <a class="button button-primary" href={at("/docs/getting-started")}>Follow the guide <span aria-hidden="true">→</span></a>
    </div>
    <div class="code-window">
      <div class="code-tabs" role="tablist" aria-label="Quickstart examples">
        <button role="tab" aria-selected="true" data-code-tab="python">Python</button>
        <button role="tab" aria-selected="false" data-code-tab="publish">Publish</button>
        <span>quickstart</span>
      </div>
      <pre data-code-panel="python"><code><span class="kw">import</span> parqdb

session = parqdb.<span class="fn">connect</span>(<span class="str">"./parqdb-data"</span>)
session.<span class="fn">register_parquet</span>(
    <span class="str">"documents"</span>,
    parqdb.datasets.<span class="fn">uri</span>(<span class="str">"documents"</span>),
)
documents = session.<span class="fn">table</span>(<span class="str">"documents"</span>)

documents.<span class="fn">create_index</span>(
    <span class="str">"documents_embedding"</span>,
    column=<span class="str">"embedding"</span>,
    key=[<span class="str">"document_id"</span>],
    config=parqdb.<span class="fn">IVF</span>(nlist=<span class="num">3</span>),
)
documents.<span class="fn">wait_for_index</span>(<span class="str">"documents_embedding"</span>)

hits = session.<span class="fn">collect</span>(
    documents.<span class="fn">search</span>([<span class="num">0.2</span>, <span class="num">0.0</span>])
    .<span class="fn">where</span>(<span class="str">"status = 'published'"</span>)
    .<span class="fn">limit</span>(<span class="num">10</span>)
)</code></pre>
      <pre data-code-panel="publish" hidden><code><span class="prompt">$</span> pip install <span class="str">"parqdb[publish]"</span>

<span class="prompt">$</span> parqdb publish \
    --source documents.parquet \
    --key chunk_id \
    --vector-column embedding \
    --nlist <span class="num">4096</span> \
    --encoding lvq8 \
    --destination s3://my-bucket/wiki/v1 \
    --public-url https://data.example.com/wiki/v1

<span class="comment"># manifest.json is exposed only after every
# immutable object has been uploaded and verified.</span></code></pre>
    </div>
  </section>

  <section class="browser-feature shell">
    <div class="browser-panel">
      <div class="browser-copy">
        <span class="eyebrow">Static HTTP index</span>
        <h2>Object storage becomes the query endpoint.</h2>
        <p>Publish an immutable IVF-LVQ index and query only the required Parquet byte ranges in WebAssembly. No query server sits between the browser and your data.</p>
        <div class="browser-actions">
          <a class="button button-primary" href="https://search.parqdb.io/">Run the live demo <span aria-hidden="true">↗</span></a>
          <a href={at("/docs/guides/browser")}>Publication guide <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="http-trace" aria-label="Example HTTP Range trace">
        <div class="trace-header"><span>HTTP TRACE</span><span><b></b> LIVE INDEX</span></div>
        <div class="trace-row"><b>RANGE</b><span>centroids.parquet</span><code>0–262143</code><em>206</em></div>
        <div class="trace-row"><b>HIT</b><span>roots.parquet</span><code>memory cache</code><em>CACHE</em></div>
        <div class="trace-row"><b>RANGE</b><span>cid_bucket=000041</span><code>8630–144983</code><em>206</em></div>
        <div class="trace-row"><b>RANGE</b><span>documents.parquet</span><code>17465660–17483301</code><em>206</em></div>
        <div class="trace-footer"><span>QUERY TEXT NEVER LEAVES THIS TAB</span><span>WASM / LVQ8</span></div>
      </div>
    </div>
  </section>

  <section class="final-cta shell">
    <span class="eyebrow">Start in process</span>
    <h2>Keep your vectors in an open format.</h2>
    <p>Install ParqDB and build your first index from an existing Parquet table.</p>
    <div>
      <a class="button button-primary" href={at("/docs/getting-started")}>Read the docs <span aria-hidden="true">→</span></a>
      <a class="button button-secondary" href="https://github.com/parqdb-io/parqdb">View GitHub <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <script>
    document.querySelectorAll(".copy-command").forEach((button) => {
      button.addEventListener("click", async () => {
        if (!(button instanceof HTMLElement)) return;
        await navigator.clipboard.writeText(button.dataset.copy ?? "");
        button.classList.add("copied");
        window.setTimeout(() => button.classList.remove("copied"), 1400);
      });
    });

    document.querySelectorAll("[data-code-tab]").forEach((tab) => {
      tab.addEventListener("click", () => {
        if (!(tab instanceof HTMLElement)) return;
        const selected = tab.dataset.codeTab;
        document.querySelectorAll("[data-code-tab]").forEach((item) =>
          item.setAttribute("aria-selected", String(item === tab)),
        );
        document.querySelectorAll("[data-code-panel]").forEach((panel) => {
          if (panel instanceof HTMLElement) panel.hidden = panel.dataset.codePanel !== selected;
        });
      });
    });
  </script>
</SiteLayout>

<style>
  .hero { position: relative; overflow: hidden; padding: 104px 0 98px; background: radial-gradient(circle at 70% 15%, rgba(57, 113, 255, .15), transparent 35%), radial-gradient(circle at 85% 65%, rgba(110, 43, 242, .13), transparent 38%); }
  .hero::before { content: ""; position: absolute; inset: 0; pointer-events: none; opacity: .16; background-image: linear-gradient(rgba(160,190,240,.12) 1px, transparent 1px), linear-gradient(90deg, rgba(160,190,240,.12) 1px, transparent 1px); background-size: 64px 64px; mask-image: linear-gradient(to bottom, black, transparent 90%); }
  .hero-grid { position: relative; display: grid; grid-template-columns: 1.03fr .97fr; align-items: center; gap: 72px; }
  .release-pill { display: inline-flex; align-items: center; gap: 9px; padding: 7px 8px 7px 11px; border: 1px solid var(--line); border-radius: 999px; color: var(--text-2); background: rgba(9,25,55,.6); font-size: 12px; }
  .release-pill a { margin-left: 3px; padding: 4px 8px; border-radius: 999px; color: #cbdcff; background: rgba(127,168,255,.12); text-decoration: none; }
  .release-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--green); box-shadow: 0 0 12px var(--green); }
  h1 { max-width: 730px; margin: 28px 0 0; color: var(--white); font-size: clamp(52px, 6.4vw, 84px); line-height: .96; letter-spacing: -.058em; }
  h1 span { color: #a8c7ff; }
  .hero-copy > p { max-width: 650px; margin: 28px 0 0; color: var(--text-2); font-size: clamp(17px, 2vw, 20px); line-height: 1.58; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 11px; margin-top: 34px; }
  .hero-actions svg { width: 17px; height: 17px; }
  .install-line { display: flex; width: min(100%, 390px); align-items: center; margin-top: 22px; padding: 11px 12px; border: 1px solid var(--line); border-radius: 9px; color: #cedcf3; background: rgba(4,13,31,.72); font-size: 13px; }
  .install-line .prompt { margin-right: 10px; color: var(--green); }
  .copy-command { width: 28px; height: 28px; margin-left: auto; padding: 5px; border: 0; color: var(--text-3); background: transparent; cursor: pointer; }
  .copy-command svg { width: 16px; height: 16px; }
  .check-icon, .copy-command.copied .copy-icon { display: none; }
  .copy-command.copied .check-icon { display: block; color: var(--green); }
  .query-card { position: relative; border: 1px solid rgba(134,173,234,.23); border-radius: 14px; background: linear-gradient(145deg, rgba(13,35,76,.92), rgba(5,16,37,.95)); box-shadow: 0 32px 80px rgba(0,0,0,.32), inset 0 1px 0 rgba(255,255,255,.04); transform: perspective(1200px) rotateY(-3deg) rotateX(1deg); }
  .query-card::after { content: ""; position: absolute; inset: 9% -10% -9% 16%; z-index: -1; border-radius: 50%; background: rgba(80,106,255,.18); filter: blur(55px); }
  .query-card-head { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 15px 17px; border-bottom: 1px solid var(--line); color: #7890b6; font-family: monospace; font-size: 10px; letter-spacing: .08em; }
  .query-card-head > div { display: flex; gap: 5px; }
  .query-card-head i { width: 7px; height: 7px; border-radius: 50%; background: #2a4774; }
  .query-card-head .live { justify-self: end; color: #78cbb5; }
  .live b { display: inline-block; width: 5px; height: 5px; margin-right: 5px; border-radius: 50%; background: var(--green); }
  .plan-body { padding: 25px 20px; }
  .plan-row { display: grid; grid-template-columns: 30px 72px 1fr auto; align-items: center; min-height: 56px; padding: 0 12px; border: 1px solid rgba(137,173,228,.15); border-radius: 8px; background: rgba(7,20,46,.6); font-family: monospace; font-size: 11px; }
  .plan-row.active { box-shadow: inset 2px 0 var(--blue); }
  .plan-row.result { box-shadow: inset 2px 0 var(--violet); }
  .step { color: #55729f; }
  .operator { color: var(--white); font-weight: 700; }
  .detail { color: #9db0ce; }
  .metric { color: #67dcb9; }
  .plan-line { height: 17px; padding-left: 25px; }
  .plan-line span { display: block; width: 1px; height: 100%; background: linear-gradient(var(--blue), var(--violet)); opacity: .55; }
  .object-strip { display: flex; justify-content: space-between; padding: 15px 20px; border-top: 1px solid var(--line); color: #5f779f; font-family: monospace; font-size: 9px; letter-spacing: .13em; }
  .benchmark-bar { padding: 34px 0 25px; border-block: 1px solid var(--line); background: #06132c; }
  .benchmark-grid { display: grid; grid-template-columns: repeat(4, 1fr); }
  .benchmark-grid > * { padding: 0 28px; border-right: 1px solid var(--line); text-decoration: none; }
  .benchmark-grid > *:first-child { padding-left: 0; }
  .benchmark-grid > *:last-child { border: 0; }
  .benchmark-grid strong { display: block; color: var(--white); font-size: 25px; letter-spacing: -.035em; }
  .benchmark-grid span { display: block; margin-top: 4px; color: var(--text-3); font-size: 12px; }
  .benchmark-note { margin-top: 25px; color: #7e93b6; font-size: 10px; text-transform: uppercase; letter-spacing: .08em; }
  .principles { padding-block: 144px; }
  .principle-grid { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 74px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .principle-grid article { position: relative; min-height: 410px; padding: 40px 34px 34px; border-right: 1px solid var(--line); }
  .principle-grid article:last-child { border: 0; }
  .feature-index { position: absolute; top: 16px; right: 18px; color: #7a90b4; font-family: monospace; font-size: 10px; }
  .feature-icon { position: relative; width: 54px; height: 54px; margin-bottom: 42px; }
  .feature-icon.layers span { position: absolute; left: 4px; width: 43px; height: 17px; border: 1px solid #78a5ef; transform: skewY(-13deg); background: rgba(40,185,255,.08); }
  .feature-icon.layers span:nth-child(2) { top: 14px; border-color: #9668ed; }
  .feature-icon.layers span:nth-child(3) { top: 28px; border-color: #27b8fb; }
  .feature-icon.bounded { border: 1px solid #506c99; border-radius: 3px; }
  .feature-icon.bounded span:first-child { position: absolute; inset: 9px; border: 1px dashed #9b69ff; }
  .feature-icon.bounded span:last-child { position: absolute; top: 19px; left: -5px; width: 62px; height: 13px; background: linear-gradient(90deg, transparent, rgba(40,185,255,.65), transparent); }
  .feature-icon.relational span { position: absolute; width: 13px; height: 13px; border: 2px solid var(--blue); border-radius: 50%; }
  .feature-icon.relational span:nth-child(2) { right: 0; top: 20px; border-color: var(--violet); }
  .feature-icon.relational span:nth-child(3) { bottom: 0; left: 7px; border-color: var(--navy); }
  .feature-icon.relational::before, .feature-icon.relational::after { content: ""; position: absolute; height: 1px; background: #6f8cbd; transform-origin: left; }
  .feature-icon.relational::before { width: 37px; top: 9px; left: 11px; transform: rotate(27deg); }
  .feature-icon.relational::after { width: 35px; top: 15px; left: 8px; transform: rotate(80deg); }
  article h3 { margin: 0; color: var(--white); font-size: 22px; letter-spacing: -.025em; }
  article p { min-height: 110px; margin: 17px 0 25px; color: var(--text-2); font-size: 15px; line-height: 1.7; }
  article a { color: #b9d0f8; font-size: 13px; font-weight: 650; text-decoration: none; }
  .architecture { padding: 132px 0 142px; border-block: 1px solid var(--line); background: #06132c; }
  .architecture-head { display: grid; grid-template-columns: 1fr 360px; align-items: end; gap: 64px; }
  .architecture-head > p { margin: 0 0 6px; color: var(--text-2); line-height: 1.7; }
  .runtime-map { display: grid; grid-template-columns: 1fr 130px 1fr 150px 1.2fr; align-items: center; margin-top: 76px; }
  .map-node { position: relative; min-height: 168px; padding: 24px; border: 1px solid var(--line); border-radius: 10px; background: rgba(9,29,63,.72); }
  .map-node strong, .map-node small { display: block; }
  .map-node strong { margin-top: 28px; color: var(--white); font-size: 18px; }
  .map-node small { margin-top: 6px; color: var(--text-3); }
  .map-node > b { position: absolute; right: 18px; bottom: 17px; color: #7894bd; font-family: monospace; font-size: 10px; }
  .node-type { color: var(--blue); font-family: monospace; font-size: 10px; letter-spacing: .12em; }
  .index-node { box-shadow: inset 0 2px var(--violet); }
  .map-connector { position: relative; height: 1px; background: #38557e; }
  .map-connector::after { content: ""; position: absolute; top: -3px; right: -1px; border-left: 6px solid #6687b8; border-block: 3px solid transparent; }
  .map-connector b { position: absolute; top: -21px; left: 50%; color: #7890b6; font-family: monospace; font-size: 9px; transform: translateX(-50%); }
  .map-fanout { display: flex; flex-direction: column; justify-content: space-between; height: 150px; padding-block: 20px; border-left: 1px solid #38557e; }
  .map-fanout span { display: block; width: 100%; height: 1px; background: #38557e; }
  .runtime-nodes { display: grid; gap: 10px; }
